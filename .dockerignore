# Keep the build context small and never ship secrets or local state.
**/node_modules
**/dist
**/build
**/.turbo
**/coverage
storage/
.git
.gitignore
.env
.env.*
!.env.example
*.log
.DS_Store
.vscode
.idea
# The web app is built into its own container image (apps/web/Dockerfile), so its
# source must remain in the build context. The API image only copies
# apps/web/package.json explicitly, so keeping web sources here is harmless there.
# (Build output is still excluded via the **/dist rule above.)
docs
infrastructure
