# CrawlOps environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ---- Firecrawl (REQUIRED for real execution) ----
# Get a key at https://www.firecrawl.dev. Uses the free allocation during development.
FIRECRAWL_API_KEY=

# ---- Database (REQUIRED for persistence) ----
# Local PostgreSQL via Docker (see infrastructure/docker/docker-compose.yml).
# Host port is 5433 to avoid clashing with a local PostgreSQL on 5432.
DATABASE_URL=postgresql://crawlops:crawlops@localhost:5433/crawlops?schema=public

# ---- Evaluator (OPTIONAL) ----
# "deterministic" (default, no API key needed) or "openai".
EVALUATOR_PROVIDER=deterministic

# ---- OpenAI (OPTIONAL evaluator provider) ----
# Only needed if EVALUATOR_PROVIDER=openai. App runs fully without it.
OPENAI_API_KEY=
OPENAI_EVALUATOR_MODEL=gpt-4o-mini

# ---- Cost / safety caps (have sensible defaults in code) ----
MAX_FIRECRAWL_CALLS_PER_RUN=5
MAX_SEARCH_RESULTS=5
MAX_RETRIES=2
FIRECRAWL_TIMEOUT_MS=30000

# ---- Logging ----
LOG_LEVEL=info

# ---- API server (production/cloud) ----
# Fastify honours PORT and HOST. Azure Container Apps injects PORT.
# HOST defaults to 0.0.0.0 so the container is reachable.
# PORT=4000
# HOST=0.0.0.0

# CORS: in production set this to the exact frontend origin (Azure Static Web
# Apps URL). Leave unset in local dev to allow the Vite dev server.
# WEB_ORIGIN=https://your-app.azurestaticapps.net

# ---- Frontend (apps/web, build-time) ----
# Local dev: leave UNSET so the app uses same-origin + the Vite proxy.
# Production: set to the deployed API base URL (Azure Container Apps).
# VITE_API_URL=https://crawlops-api.<region>.azurecontainerapps.io
